{
  "name": "yt-video-downloader",
  "version": "1.0.0",
  "description": "Multi-platform video downloader with support for YouTube, Facebook, Instagram",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install",
    "dev:server": "nodemon server/index.js",
    "dev:frontend": "cd frontend && npm start"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "fs-extra": "^11.1.1",
    "path": "^0.12.7",
    "child_process": "^1.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "youtube",
    "video",
    "downloader",
    "facebook",
    "instagram",
    "yt-dlp"
  ],
  "author": "YT Downloader",
  "license": "MIT"
}